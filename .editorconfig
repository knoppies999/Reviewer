root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.ps1]
indent_size = 4
# The scripts are deliberately ASCII-only: Windows PowerShell 5.1 reads a BOM-less
# file as ANSI, so a stray non-ASCII character changes how the script parses there.
charset = utf-8
